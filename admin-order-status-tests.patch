+    public function test_fulfillment_status_transitions_do_not_deduct_variant_stock_again(): void
+    {
+        [$order, $product, $variant, $inventory] = $this->createOrderWithVariantStock(
+            'pending'
+        );
+
+        $admin = User::factory()->create(['role' => 'admin']);
+
+        foreach (['processing', 'shipped', 'completed'] as $status) {
+            $this->actingAs($admin)->patch(
+                route('admin.orders.status', $order),
+                ['status' => $status]
+            );
+
+            $this->assertSame($status, $order->fresh()->status);
+            $this->assertSame(8, (int) $inventory->fresh()->quantity);
+            $this->assertSame(8, (int) $product->fresh()->stock);
+        }
+
+        $this->assertSame(
+            0,
+            $variant->inventoryMovements()
+                ->where('type', 'return')
+                ->where('reference_type', Order::class)
+                ->where('reference_id', $order->id)
+                ->count()
+        );
+    }
+
+    public function test_canceling_processing_order_restores_variant_stock_only_once(): void
+    {
+        [$order, $product, $variant, $inventory] = $this->createOrderWithVariantStock(
+            'processing'
+        );
+
+        $admin = User::factory()->create(['role' => 'admin']);
+
+        $this->actingAs($admin)->patch(
+            route('admin.orders.status', $order),
+            ['status' => 'canceled']
+        );
+
+        $this->assertSame('canceled', $order->fresh()->status);
+        $this->assertSame(10, (int) $inventory->fresh()->quantity);
+        $this->assertSame(10, (int) $product->fresh()->stock);
+
+        // Repeating the cancellation request must not restore stock again.
+        $this->actingAs($admin)->patch(
+            route('admin.orders.status', $order),
+            ['status' => 'canceled']
+        );
+
+        $this->assertSame('canceled', $order->fresh()->status);
+        $this->assertSame(10, (int) $inventory->fresh()->quantity);
+        $this->assertSame(10, (int) $product->fresh()->stock);
+
+        $this->assertSame(
+            1,
+            $variant->inventoryMovements()
+                ->where('type', 'return')
+                ->where('reference_type', Order::class)
+                ->where('reference_id', $order->id)
+                ->count()
+        );
+    }
+
